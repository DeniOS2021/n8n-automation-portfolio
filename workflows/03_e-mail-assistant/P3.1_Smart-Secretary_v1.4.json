    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\n\n// Headers: handle both simplified object and raw array formats\nconst headersObj = (e.headers && !Array.isArray(e.headers)) ? e.headers : {};\nconst headersArr = (e.payload && Array.isArray(e.payload.headers)) ? e.payload.headers : [];\nconst getHeader = (name) => {\n  const lname = name.toLowerCase();\n  if (headersObj[lname]) return headersObj[lname];\n  const h = headersArr.find(x => (x.name || '').toLowerCase() === lname);\n  return h ? h.value : '';\n};\n\n// Body: prefer decoded text, then raw payload parts, then snippet\nfunction decode(data) {\n  try { return Buffer.from(data, 'base64').toString('utf-8'); } catch (err) { return ''; }\n}\nfunction extractBody(payload) {\n  if (!payload) return '';\n  if (payload.mimeType === 'text/plain' && payload.body && payload.body.data) return decode(payload.body.data);\n  if (payload.parts && payload.parts.length) {\n    for (const p of payload.parts) {\n      if (p.mimeType === 'text/plain' && p.body && p.body.data) return decode(p.body.data);\n    }\n    for (const p of payload.parts) {\n      const r = extractBody(p);\n      if (r) return r;\n    }\n  }\n  if (payload.body && payload.body.data) return decode(payload.body.data);\n  return '';\n}\nlet body = e.text || e.textPlain || '';\nif (!body && e.payload) body = extractBody(e.payload);\nif (!body) body = e.snippet || '';\n\n// Sender\nlet fromRaw = '';\nlet fromName = '';\nif (e.from && e.from.value && e.from.value[0]) {\n  fromRaw = e.from.value[0].address || '';\n  fromName = e.from.value[0].name || '';\n} else if (typeof e.from === 'string' && e.from) {\n  fromRaw = e.from;\n} else {\n  fromRaw = getHeader('From');\n}\nconst m = String(fromRaw).match(/^\\s*\"?([^\"<]*?)\"?\\s*<(.+?)>\\s*$/);\nlet fromEmail = fromRaw;\nif (m) {\n  if (!fromName) fromName = m[1].trim();\n  fromEmail = m[2].trim();\n}\n\nconst subject = e.subject || getHeader('Subject') || '(no subject)';\nconst date = e.date || getHeader('Date') || '';\n\nreturn [{\n  json: {\n    emailId: e.id || '',\n    threadId: e.threadId || '',\n    subject,\n    from: fromEmail,\n    fromName,\n    date,\n    body,\n  }\n}];"
      },
