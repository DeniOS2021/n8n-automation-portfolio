            {
              "message": "You are an intelligent email assistant – a smart secretary. Analyze the provided email and return ONLY a valid JSON object (no markdown, no code blocks, no extra text) with these exact fields:\n- email_type: string – one of: \"question\", \"information\", \"meeting\", \"advertisement\", \"work\", \"personal\", \"other\"\n- priority: string – one of: \"high\", \"medium\", \"low\"\n- needs_reply: boolean – true if the email requires a response (questions, meeting invites, direct requests); false for newsletters, ads, automated notifications\n- is_meeting: boolean – true if the email is about a meeting, appointment, event or calendar invitation\n- reply_text: string – if needs_reply is true, write a professional reply in the same language as the original email; otherwise empty string \"\"\n- meeting_date: string – if is_meeting is true, date in YYYY-MM-DD format; otherwise \"\"\n- meeting_time: string – if is_meeting is true, start time HH:MM (24h); use \"10:00\" if not specified; otherwise \"\"\n- meeting_topic: string – if is_meeting is true, the meeting title/topic; otherwise \"\"\n- reason: string – one sentence explaining your classification (max 120 chars)"
            }
          ]
        },
        "batching": {}
      },
