    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst raw = item.json;\nconst binary = item.binary || {};\nconst clean = (s) => String(s || '').replace(/[^\\w\\s.-]/g, '').trim();\n\n// Read sender directly from Gmail Trigger output (runs in parallel with Normalize Email)\nlet fromEmail = '';\nlet fromName = '';\nif (raw.from && raw.from.value && raw.from.value[0]) {\n  fromEmail = raw.from.value[0].address || '';\n  fromName = raw.from.value[0].name || '';\n} else if (typeof raw.from === 'string') {\n  fromEmail = raw.from;\n}\nconst subject = raw.subject || '(no subject)';\nconst date = raw.date || '';\nconst stamp = (date && date.length >= 10) ? date.slice(0, 10) : new Date().toISOString().slice(0, 10);\n\nconst cleanFromName = clean(fromName) || 'sender';\nconst clientFolderName = cleanFromName !== 'sender'\n  ? cleanFromName\n  : clean(fromEmail.split('@')[0]) || 'Unknown Sender';\n\nconst out = [];\nfor (const key of Object.keys(binary)) {\n  const b = binary[key];\n  const origName = b.fileName || key;\n  out.push({\n    json: {\n      fileName: stamp + '_' + cleanFromName + '_' + origName,\n      originalName: origName,\n      mimeType: b.mimeType || '',\n      from: fromEmail,\n      subject,\n      clientFolderName,\n    },\n    binary: { data: b },\n  });\n}\nreturn out;"
      },
