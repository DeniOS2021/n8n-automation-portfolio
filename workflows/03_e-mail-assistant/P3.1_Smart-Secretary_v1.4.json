    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst email = $('Normalize Email').first().json;\n\n// Get text output from chainLlm\nconst aiText = item.json.text || '';\n\n// Parse JSON from AI response\nlet analysis = {};\ntry {\n  analysis = JSON.parse(aiText);\n} catch(e) {\n  const match = aiText.match(/\\{[\\s\\S]*\\}/);\n  if (match) {\n    try { analysis = JSON.parse(match[0]); } catch(e2) {}\n  }\n}\n\n// Apply defaults\nif (!analysis.email_type)               analysis.email_type = 'other';\nif (!analysis.priority)                 analysis.priority = 'medium';\nif (analysis.needs_reply === undefined) analysis.needs_reply = false;\nif (analysis.is_meeting === undefined)  analysis.is_meeting = false;\nif (!analysis.reply_text)              analysis.reply_text = '';\nif (!analysis.meeting_date)            analysis.meeting_date = '';\nif (!analysis.meeting_time)            analysis.meeting_time = '10:00';\nif (!analysis.meeting_topic)           analysis.meeting_topic = '';\nif (!analysis.reason)                  analysis.reason = '';\n\n// Email metadata from Normalize Email\nconst subject   = email.subject || '(no subject)';\nconst fromEmail = email.from || '';\nconst fromName  = email.fromName || '';\n\n// Build datetime for Google Calendar in Europe/Berlin (DST-aware, 1 hour event)\nconst TZ = 'Europe/Berlin';\nlet meetingStart = '';\nlet meetingEnd   = '';\nlet meetingStartHuman = '';\nlet meetingAltHuman   = '';\nif (analysis.is_meeting && analysis.meeting_date) {\n  const time = analysis.meeting_time || '10:00';\n  const startDT = DateTime.fromISO(analysis.meeting_date + 'T' + time, { zone: TZ });\n  if (startDT.isValid) {\n    meetingStart = startDT.toISO();\n    meetingEnd   = startDT.plus({ hours: 1 }).toISO();\n    meetingStartHuman = startDT.toFormat('dd.MM.yyyy HH:mm');\n    meetingAltHuman   = startDT.plus({ days: 1 }).toFormat('dd.MM.yyyy HH:mm');\n  }\n}\n\n// Downgrade is_meeting if AI found no specific date/time\nif (!meetingStart) analysis.is_meeting = false;\n\n// Human-readable action for log\nconst actionParts = [];\nif (analysis.is_meeting)  actionParts.push('Calendar Event');\nif (analysis.needs_reply) actionParts.push(String(analysis.priority).toLowerCase() === 'high' ? 'Reply Sent' : 'Draft Reply');\nif (!actionParts.length)  actionParts.push('Ignored');\nconst action = actionParts.join(' + ');\n\nreturn [{\n  json: {\n    emailId:       email.emailId,\n    threadId:      email.threadId || '',\n    subject,\n    from:          fromEmail,\n    fromName,\n    emailBody:     email.body || '',\n    email_type:    analysis.email_type,\n    priority:      analysis.priority,\n    needs_reply:   analysis.needs_reply === true,\n    is_meeting:    analysis.is_meeting  === true,\n    reply_text:    analysis.reply_text,\n    meeting_topic: analysis.meeting_topic || subject,\n    meeting_date:  analysis.meeting_date,\n    meeting_time:  analysis.meeting_time,\n    meeting_start: meetingStart,\n    meeting_end:   meetingEnd,\n    meeting_start_human: meetingStartHuman,\n    meeting_alt_human:   meetingAltHuman,\n    reason:        analysis.reason,\n    reply_subject: 'Re: ' + subject,\n    action,\n  }\n}];"
      },
