      "id": "5293d08c-29c2-4872-a5bd-59e9a67e885b",
      "name": "Запись транскрипта в Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1040,
