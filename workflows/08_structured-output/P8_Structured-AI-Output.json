      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"affected_component\": {\n      \"type\": \"string\"\n    },\n    \"problem_description\": {\n      \"type\": \"string\"\n    },\n    \"error_text_visible\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"severity\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"critical\",\n        \"high\",\n        \"medium\",\n        \"low\"\n      ]\n    },\n    \"reasoning_summary\": {\n      \"type\": \"string\"\n    },\n    \"recommended_action\": {\n      \"type\": \"string\"\n    },\n    \"confidence\": {\n      \"type\": \"number\"\n    },\n    \"needs_human_review\": {\n      \"type\": \"boolean\"\n    },\n    \"unclear_areas\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    }\n  },\n  \"required\": [\n    \"affected_component\",\n    \"problem_description\",\n    \"severity\",\n    \"reasoning_summary\",\n    \"recommended_action\",\n    \"confidence\",\n    \"needs_human_review\"\n  ]\n}"
      },
